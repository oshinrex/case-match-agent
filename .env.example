# CockroachDB Cloud connection string.
# Get it from the Cloud Console: Connect -> General connection string.
# Keep the cockroachdb:// scheme so SQLAlchemy uses the CockroachDB dialect.
DATABASE_URL=cockroachdb://<user>:<password>@<host>:26257/<database>?sslmode=verify-full

# Region where Bedrock model access is enabled for your account.
# Kept separate from AWS_REGION because model access is granted per region.
BEDROCK_REGION=us-east-1

# Amazon Titan Text Embeddings V2 - produces the 1024-dim vectors.
EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# Model used for precedent evaluation and pitch drafting.
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
